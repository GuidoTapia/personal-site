---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';

export const getStaticPaths = (async () => {
  const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}) satisfies GetStaticPaths;

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<Base title={data.title} description={data.summary} type="article">
  <article class="container case">
    <a class="back" href="/#work">
      ← All work
    </a>

    <header class="case__header">
      <p class="eyebrow">{data.kind === 'case-study' ? 'Case study' : 'Achievement'}</p>
      <h1>{data.title}</h1>
      <p class="case__summary">{data.summary}</p>
      <p class="case__meta">
        {data.role} · {data.period}
      </p>
    </header>

    {data.metrics.length > 0 && (
      <dl class="metrics">
        {data.metrics.map(m => (
          <div>
            <dd>{m.value}</dd>
            <dt>{m.label}</dt>
          </div>
        ))}
      </dl>
    )}

    {data.cover && (
      <Image
        src={data.cover}
        alt={data.coverAlt ?? ''}
        width={Math.min(1120, data.cover.width)}
        quality={80}
        class="cover"
        loading="eager"
      />
    )}

    <div class="case__layout">
      <div class="prose">
        <Content />
      </div>

      <aside class="case__aside">
        {data.tech.length > 0 && (
          <div>
            <h2>Stack and tools</h2>
            <ul class="tags">
              {data.tech.map(t => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        )}
        {data.links.length > 0 && (
          <div>
            <h2>Links</h2>
            <ul class="links">
              {data.links.map(l => (
                <li>
                  <a class="link" href={l.url} target="_blank" rel="noopener">
                    {l.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>

    <nav class="next" aria-label="Next case study">
      <span>Next</span>
      <a href={`/work/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  .case {
    padding-block: clamp(32px, 6vw, 72px) clamp(64px, 9vw, 112px);
  }

  .back {
    display: inline-block;
    margin-bottom: clamp(32px, 6vw, 56px);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
  }

  .back:hover {
    color: var(--accent);
  }

  .case__header {
    max-width: 820px;
  }

  h1 {
    font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem);
    letter-spacing: -0.03em;
  }

  .case__summary {
    margin: 20px 0 0;
    color: var(--text);
    font-size: var(--fz-lg);
    line-height: 1.45;
  }

  .case__meta {
    margin: 16px 0 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1px;
    margin: clamp(32px, 5vw, 56px) 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
    overflow: hidden;
  }

  .metrics div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px;
    background: var(--bg);
  }

  .metrics dd {
    margin: 0;
    color: var(--accent);
    font-size: var(--fz-xl);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .metrics dt {
    font-size: var(--fz-xs);
    line-height: 1.45;
  }

  .cover {
    width: 100%;
    margin-top: clamp(32px, 5vw, 56px);
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(32px, 6vw, 80px);
    margin-top: clamp(16px, 3vw, 32px);
  }

  .case__aside {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 32px);
    margin-top: 2.2em;
  }

  .case__aside h2 {
    margin-bottom: 12px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--fz-sm);
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: clamp(56px, 8vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .next span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .next a {
    color: var(--text);
    font-size: var(--fz-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.2s var(--ease);
  }

  .next a:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .case__layout {
      grid-template-columns: 1fr;
    }

    .case__aside {
      position: static;
      margin-top: 0;
    }
  }
</style>
