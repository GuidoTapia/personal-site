---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found">
  <section class="container notfound">
    <p class="eyebrow">404</p>
    <h1>This page didn’t pass the audit.</h1>
    <p>
      The link may be from an older version of this site. Everything current is on the homepage.
    </p>
    <a class="btn btn--primary" href="/">
      Back home
    </a>
  </section>
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: calc(100svh - var(--header-h) - 90px);
    padding-block: 64px;
  }

  h1 {
    max-width: 18ch;
    margin-bottom: 20px;
    font-size: var(--fz-2xl);
    letter-spacing: -0.035em;
  }
</style>
