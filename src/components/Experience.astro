---
import { getCollection, render } from 'astro:content';

const jobs = (await getCollection('jobs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const rendered = await Promise.all(
  jobs.map(async job => ({ job, Content: (await render(job)).Content })),
);
---

<section id="experience" class="section experience" aria-labelledby="experience-title">
  <div class="container">
    <p class="eyebrow">02 · Experience</p>
    <h2 id="experience-title" class="section-title">
      Where I’ve worked.
    </h2>

    <ol class="jobs">
      {rendered.map(({ job, Content }) => (
        <li class="job reveal">
          <p class="job__range">{job.data.range}</p>
          <div>
            <h3>
              {job.data.title}{' '}
              <a class="job__company" href={job.data.url} target="_blank" rel="noopener">
                @ {job.data.company}
              </a>
            </h3>
            <p class="job__location">{job.data.location}</p>
            <div class="job__body">
              <Content />
            </div>
            {job.data.tech.length > 0 && (
              <ul class="tags" aria-label="Technologies">
                {job.data.tech.map(t => (
                  <li>{t}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="experience__more">
      I also taught IT and robotics at Universidad Católica San Pablo, CEPROTEC, and a secondary
      school between 2018 and 2021. The full history is in my{' '}
      <a class="link" href="/resume.pdf" target="_blank" rel="noopener">
        resume
      </a>
      .
    </p>
  </div>
</section>

<style>
  .experience {
    border-block: 1px solid var(--line);
    background: var(--bg-sunken);
  }

  .jobs {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .job {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 32px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
  }

  .job:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .job__range {
    margin: 4px 0 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    letter-spacing: 0.02em;
  }

  h3 {
    font-size: var(--fz-lg);
    font-weight: 600;
    line-height: 1.3;
  }

  .job__company {
    color: var(--accent);
    white-space: nowrap;
  }

  .job__company:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .job__location {
    margin: 4px 0 16px;
    color: var(--faint);
    font-size: var(--fz-xs);
  }

  .job__body :global(ul) {
    margin-bottom: 18px;
    list-style: none;
  }

  .job__body :global(li) {
    position: relative;
    max-width: 72ch;
    margin-bottom: 10px;
    padding-left: 22px;
    font-size: var(--fz-sm);
  }

  .job__body :global(li)::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: var(--accent);
  }

  .experience__more {
    max-width: 68ch;
    margin: 40px 0 0;
    font-size: var(--fz-sm);
  }

  @media (max-width: 760px) {
    .job {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
