---
import { Image } from 'astro:assets';
import memoji from '@/assets/memoji.png';
import { site } from '@/data/site';
import { langFromUrl, languages, localePath, translatePath, type Lang } from '@/i18n';
import { ui } from '@/i18n/ui';

const lang = langFromUrl(Astro.url);
const t = ui[lang];
const home = localePath(lang, '/');
const nav = (['story', 'work', 'experience', 'about', 'contact'] as const).map(id => ({
  label: t.nav[id],
  href: `${home}#${id}`,
}));
const switcher = (Object.keys(languages) as Lang[]).map(l => ({
  lang: l,
  href: translatePath(Astro.url, l),
  current: l === lang,
}));
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={home} aria-label={`${site.name}, ${t.a11y.home}`}>
      <span class="brand__avatar" data-memoji>
        <Image src={memoji} alt="" width={72} height={72} loading="eager" />
        <!-- Animated memoji, fetched only on hover: HEVC with alpha for Safari, VP9 with alpha elsewhere -->
        <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
      </span>
      <span class="brand__name">{site.shortName}</span>
    </a>

    <nav class="nav" aria-label={t.a11y.primaryNav}>
      <ul class="nav__links">
        {nav.map(item => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <!-- Understand lens toggle (src/scripts/lens.ts). Hidden until the script runs. -->
      <button
        type="button"
        class="lens-toggle"
        data-lens-toggle
        data-drag={t.lens.drag}
        aria-pressed="false"
        title={t.lens.hint}
        hidden>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle
            cx="8"
            cy="8"
            r="6.25"
            fill="none"
            stroke="currentColor"
            stroke-dasharray="2 1.6"
          />
          <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5Z" fill="currentColor" />
        </svg>
        <span class="lens-toggle__label">{t.lens.label}</span>
      </button>
      <ul class="lang" aria-label={t.a11y.language}>
        {switcher.map(s => (
          <li>
            <a
              href={s.href}
              hreflang={s.lang}
              lang={s.lang}
              aria-current={s.current ? 'true' : undefined}
              title={languages[s.lang]}>
              {s.lang.toUpperCase()}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn nav__resume" href={t.resumeUrl} target="_blank" rel="noopener">
        {t.resume}
      </a>

      <details class="menu">
        <summary aria-label={t.a11y.openMenu}>
          <span></span>
          <span></span>
        </summary>
        <ul class="menu__panel">
          {nav.map(item => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li>
            <a href={t.resumeUrl} target="_blank" rel="noopener">
              {t.resume}
            </a>
          </li>
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu after choosing a section.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => (menu.open = false)));

  // Play the animated memoji on hover/focus only, so the video never loads up front.
  const avatar = document.querySelector<HTMLElement>('[data-memoji]');
  const video = avatar?.querySelector('video');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (avatar && video && !reduced) {
    const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
    const start = () => {
      if (!video.src) video.src = isSafari ? '/memoji-guido.MOV' : '/memoji-guido.webm';
      video
        .play()
        .then(() => avatar.classList.add('is-playing'))
        .catch(() => {});
    };
    const stop = () => {
      video.pause();
      avatar.classList.remove('is-playing');
    };
    const link = avatar.closest('a');
    link?.addEventListener('pointerenter', start);
    link?.addEventListener('pointerleave', stop);
    link?.addEventListener('focus', start);
    link?.addEventListener('blur', stop);
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  /* Reading progress: an amber hairline on the header's bottom edge, driven by page scroll */
  @media (prefers-reduced-motion: no-preference) {
    .header::after {
      content: '';
      position: absolute;
      right: 0;
      bottom: -1px;
      left: 0;
      height: 1px;
      background: var(--accent);
      transform-origin: 0 50%;
      /* Browsers without scroll timelines get --scroll-progress from src/scripts/motion.ts */
      transform: scaleX(var(--scroll-progress, 0));
    }

    @supports (animation-timeline: scroll()) {
      .header::after {
        animation-name: progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
      }

      @keyframes progress {
        from {
          transform: scaleX(0);
        }
        to {
          transform: scaleX(1);
        }
      }
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand__avatar {
    position: relative;
    display: block;
    width: 36px;
    height: 36px;
  }

  .brand__avatar img,
  .brand__avatar video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand__avatar video {
    opacity: 0;
  }

  .brand__avatar:global(.is-playing) video {
    opacity: 1;
  }

  .brand__avatar:global(.is-playing) img {
    opacity: 0;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav__links {
    display: flex;
    gap: 28px;
    list-style: none;
  }

  .nav__links a {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fz-xs);
    transition: color 0.2s var(--ease);
  }

  .nav__links a:hover {
    color: var(--accent);
  }

  .lang {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    list-style: none;
  }

  .lang a {
    display: block;
    padding: 4px 9px;
    border-radius: 999px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    transition:
      color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .lang a:hover {
    color: var(--text);
  }

  .lang a[aria-current] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .lens-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 32px;
    padding: 0 12px 0 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .lens-toggle[hidden] {
    display: none;
  }

  .lens-toggle:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .lens-toggle[aria-pressed='true'] {
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .nav__resume {
    min-height: 36px;
    padding: 0 16px;
  }

  .menu {
    display: none;
    position: relative;
  }

  .menu summary {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu summary span {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.2s var(--ease);
  }

  .menu[open] summary span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu[open] summary span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 200px;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    list-style: none;
  }

  .menu__panel a {
    display: block;
    padding: 12px 14px;
    border-radius: 6px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--fz-sm);
  }

  .menu__panel a:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .nav__links a,
  .brand__name {
    white-space: nowrap;
  }

  /* Tablets and small laptops: six links, the lens, the switch, and the resume have to fit. */
  @media (max-width: 1080px) {
    .nav,
    .nav__links {
      gap: 18px;
    }

    /* Icon only from here down; the label stays as the accessible name */
    .lens-toggle {
      width: 36px;
      height: 36px;
      padding: 0;
      justify-content: center;
    }

    .lens-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  @media (max-width: 860px) {
    .nav__links,
    .nav__resume {
      display: none;
    }

    .menu {
      display: block;
    }

    .nav {
      gap: 12px;
    }
  }
</style>
