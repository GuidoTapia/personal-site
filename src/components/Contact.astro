---
import { site, socials } from '@/data/site';
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <p class="eyebrow">04 · Contact</p>
    <h2 id="contact-title">Let’s talk.</h2>
    <p class="contact__text">
      I’m open to remote roles in full-stack engineering, technical leadership, and solutions
      advisory. Whether you have a role in mind, a codebase you want a second opinion on, or just
      want to say hi, my inbox is open and I’ll get back to you.
    </p>
    <div class="contact__actions">
      <a class="btn btn--primary" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      {socials.map(s => (
        <a class="btn" href={s.url} target="_blank" rel="noopener">
          {s.name}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(
        60% 80% at 50% 100%,
        color-mix(in oklab, var(--accent) 10%, transparent),
        transparent
      ),
      var(--bg);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  h2 {
    font-size: var(--fz-2xl);
    letter-spacing: -0.035em;
  }

  .contact__text {
    max-width: 58ch;
    margin: 24px 0 0;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }
</style>
