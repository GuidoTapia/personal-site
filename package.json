{
  "name": "personal-site",
  "description": "Guido Tapia Oré, personal portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "author": "Guido Tapia Oré <guido.tapia.ore@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuidoTapia/personal-site"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:types": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "validate": "yarn check:types && yarn lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,css,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.182.0",
    "eslint": "10",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "9",
    "lint-staged": "^17.6.0",
    "prettier": "3",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.72.1"
  }
}
